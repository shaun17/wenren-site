---
import { spatialAvatarAssets } from "../config/spatial-avatar-assets";

interface Props {
  name: string;
}

const { name } = Astro.props;
---

<figure class="spatial-portrait is-cache-probing" data-spatial-portrait>
  <picture
    class="spatial-portrait-fallback spatial-portrait-loading-poster"
    data-spatial-loading-poster
  >
    <source
      media="(max-width: 800px)"
      srcset={spatialAvatarAssets.loadingPosterMobile}
    />
    <img
      class="spatial-portrait-fallback-image"
      src={spatialAvatarAssets.loadingPoster}
      width="2560"
      height="1440"
      alt={`${name} 的三维人物模型：短发，穿灰色圆领上衣`}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </picture>
  <picture
    class="spatial-portrait-fallback spatial-portrait-static-poster"
    data-spatial-static-poster
    aria-hidden="true"
  >
    <source
      media="(max-width: 800px)"
      data-spatial-static-source
      data-srcset={spatialAvatarAssets.staticPosterMobile}
    />
    <img
      class="spatial-portrait-fallback-image"
      data-spatial-static-image
      data-src={spatialAvatarAssets.staticPoster}
      width="1280"
      height="720"
      alt=""
      decoding="async"
      fetchpriority="low"
    />
  </picture>
  <canvas class="spatial-portrait-canvas" aria-hidden="true" data-spatial-canvas></canvas>
  <noscript>
    <img
      class="spatial-portrait-noscript-poster"
      src={spatialAvatarAssets.staticPoster}
      width="1280"
      height="720"
      alt=""
    />
  </noscript>
  <p class="spatial-portrait-status" role="status" aria-live="polite" data-spatial-status>
    当前展示三维模型静态海报。
  </p>
</figure>

<script>
  import { initSpatialPortrait } from "../lib/spatial-portrait";

  /** 初始化当前页面唯一的空间肖像，并把资源释放交给场景自身管理。 */
  const initializeSpatialPortrait = (): void => {
    const portrait = document.querySelector<HTMLElement>("[data-spatial-portrait]");
    if (portrait) initSpatialPortrait(portrait);
  };

  initializeSpatialPortrait();
</script>
