---
import "../styles/home-sticker.css";

const stickerAsset = "/stickers/mcdonald-logo-sticker-705aee4ab869.png";
const stickerInstructions =
  "拖动移动；按住 Shift 拖动或滚轮旋转；点击页面空白处后缓慢归位";
---

<div class="home-sticker-anchor">
  <button
    class="home-sticker"
    type="button"
    aria-label={`麦当劳金色拱门贴纸。${stickerInstructions}`}
    aria-keyshortcuts="ArrowUp ArrowDown ArrowLeft ArrowRight Shift+ArrowLeft Shift+ArrowRight Escape Enter Space"
    title={stickerInstructions}
    data-home-sticker
  >
    <span class="home-sticker-float" aria-hidden="true">
      <img
        src={stickerAsset}
        width="512"
        height="512"
        alt=""
        loading="eager"
        decoding="async"
        draggable="false"
      />
    </span>
  </button>
</div>

<script>
  import { initHomeSticker } from "../lib/home-sticker";

  /** 初始化首页唯一的贴纸，并由交互模块统一处理拖拽、旋转与归位。 */
  const initializeHomeSticker = (): void => {
    const sticker = document.querySelector<HTMLElement>("[data-home-sticker]");
    if (sticker) initHomeSticker(sticker);
  };

  initializeHomeSticker();
</script>
