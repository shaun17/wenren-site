---
import "../styles/home-sticker.css";
import { HOME_STICKER_DEFINITIONS } from "../lib/home-sticker";

const stickerInstructions =
  "拖动后停在释放位置并可任意覆盖其他贴纸；单击以随机速度旋转，方向逐次交替";
---

<div
  class="home-sticker-anchor"
  role="group"
  aria-label="可拖动与旋转的贴纸组"
  data-home-sticker-deck
>
  {
    HOME_STICKER_DEFINITIONS.map((sticker) => (
      <button
        class="home-sticker"
        type="button"
        aria-label={`${sticker.label}。${stickerInstructions}`}
        aria-keyshortcuts="Escape Enter Space"
        data-home-sticker
        data-sticker-id={sticker.id}
        data-sticker-layer={sticker.initialLayer}
        style={`--sticker-x: ${sticker.initialXPercent}%; --sticker-y: ${sticker.initialYPercent}%; --sticker-layer: ${sticker.initialLayer};`}
      >
        <span class="home-sticker-spin" aria-hidden="true">
          <span class="home-sticker-surface">
            <img
              src={sticker.asset}
              width={sticker.width}
              height={sticker.height}
              alt=""
              loading="eager"
              decoding="async"
              draggable="false"
            />
          </span>
        </span>
      </button>
    ))
  }
</div>

<script>
  import { initHomeStickerDeck } from "../lib/home-sticker";

  /** 初始化首页贴纸组的自由叠放、局部压感与保留角度的点击旋转。 */
  const initializeHomeStickerDeck = (): void => {
    const deck = document.querySelector<HTMLElement>(
      "[data-home-sticker-deck]",
    );
    if (deck) initHomeStickerDeck(deck);
  };

  initializeHomeStickerDeck();
</script>
