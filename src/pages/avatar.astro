---
import DirectoryColumn from "../components/DirectoryColumn.astro";
import SpatialPortrait from "../components/SpatialPortrait.astro";
import { CATEGORY_DEFINITIONS } from "../content/categories";
import { getSiteContent } from "../content/site-content";
import { siteConfig } from "../config/runtime-site-config";
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/avatar.css";

const career = CATEGORY_DEFINITIONS.career;
const works = CATEGORY_DEFINITIONS.works;
const writing = CATEGORY_DEFINITIONS.writing;
const journal = CATEGORY_DEFINITIONS.journal;
const entries = await getSiteContent();
// 首页与空间形象页把同一份有序内容交给共享组件，由组件统一截取前四篇。
const careerEntries = entries.filter((entry) => entry.category === career.key);
const worksEntries = entries.filter((entry) => entry.category === works.key);
const writingEntries = entries.filter((entry) => entry.category === writing.key);
const journalEntries = entries.filter((entry) => entry.category === journal.key);
const portraitDescription = `${siteConfig.brand.name} 的交互式空间肖像与个人介绍。`;
---

<SiteLayout title="3D 形象" description={portraitDescription}>
  <main class="spatial-page is-spatial-static" data-spatial-page>
    <header class="spatial-header">
      <a class="spatial-brand" href="/" aria-label="返回首页">
        <span>{siteConfig.brand.name}</span>
        <span>SPATIAL RÉSUMÉ</span>
      </a>
      <a class="spatial-home-link" href="/">
        首页
        <span class="spatial-home-link-arrow" aria-hidden="true">→</span>
      </a>
    </header>

    <div class="spatial-stage" aria-hidden="false">
      <SpatialPortrait name={siteConfig.brand.name} />
    </div>

    <div class="spatial-story" aria-label={`${siteConfig.brand.name} 个人介绍与目录`}>
      <section
        class="spatial-hero spatial-chapter spatial-chapter-intro"
        data-spatial-hero
        data-spatial-chapter="0"
        aria-labelledby="spatial-about-title"
      >
        <div class="spatial-copy spatial-copy-intro">
          <p class="spatial-eyebrow">01 / ABOUT</p>
          <h1 id="spatial-about-title">About {siteConfig.brand.name}</h1>
          <div class="spatial-summary">
            {siteConfig.home.biography.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
        <p class="spatial-scroll-cue" aria-hidden="true">
          SCROLL TO EXPLORE
          <span>↓</span>
        </p>
      </section>

      <section
        class="spatial-chapter spatial-chapter-directory"
        data-spatial-chapter="1"
        data-spatial-snap-anchor
        aria-labelledby="spatial-resume-title"
      >
        <div class="spatial-copy">
          <p class="spatial-eyebrow">02 / RÉSUMÉ</p>
          <h2 id="spatial-resume-title">Résumé</h2>
          <p>从需求、设计、开发到发布，记录每一个真正落地的过程。</p>
          <nav class="spatial-directory-groups" aria-label="职业经历目录">
            <DirectoryColumn
              category={career}
              entries={careerEntries}
              headingLevel="h3"
            />
          </nav>
        </div>
      </section>

      <section
        class="spatial-chapter spatial-chapter-directory"
        data-spatial-chapter="2"
        data-spatial-snap-anchor
        aria-labelledby="spatial-independent-title"
      >
        <div class="spatial-copy">
          <p class="spatial-eyebrow">03 / INDEPENDENT</p>
          <h2 id="spatial-independent-title">独立开发</h2>
          <p>把真实问题变成可用的产品，也持续校准设计、技术与生活之间的尺度。</p>
          <nav class="spatial-directory-groups" aria-label="个人作品目录">
            <DirectoryColumn
              category={works}
              entries={worksEntries}
              headingLevel="h3"
            />
          </nav>
        </div>
      </section>

      <section
        class="spatial-chapter spatial-chapter-directory"
        data-spatial-chapter="3"
        data-spatial-snap-anchor
        aria-labelledby="spatial-notes-title"
      >
        <div class="spatial-copy spatial-copy-wide">
          <p class="spatial-eyebrow">04 / NOTES</p>
          <h2 id="spatial-notes-title">持续记录</h2>
          <p>持续写下实践中的判断，也保留那些不必成为结论的片段。</p>
          <nav
            class="spatial-directory-groups spatial-directory-groups-multiple"
            aria-label="文稿与流水账目录"
          >
            <DirectoryColumn
              category={writing}
              entries={writingEntries}
              headingLevel="h3"
            />
            <DirectoryColumn
              category={journal}
              entries={journalEntries}
              headingLevel="h3"
            />
          </nav>
        </div>
      </section>
    </div>
  </main>
</SiteLayout>
